rules_version = '2';

// Nothing in the browser ever talks to Firestore directly: the site reads and
// writes only through the Admin SDK on the server, which bypasses these rules.
// So the correct client policy is to deny everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
